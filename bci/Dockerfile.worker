# BCI worker image: runs src/worker.js (the scan/data plane) separately from
# the API image (Dockerfile, the control plane) -- spec section 6 requires
# these isolated so a compromised/crashed worker is never a compromise of
# BCI Core. Installs the M5 engine adapters' binaries using each project's
# own documented method.
#
# Pinned, not @latest: nuclei/v3@v3.11.1's go.mod requires go >= 1.26, newer
# than this image's go 1.24. GitHub Actions' setup-go defaults GOTOOLCHAIN
# to "auto" (ci.yml's bci job relies on exactly this to transparently fetch
# a newer toolchain for trivy), but the plain golang:1.24-bookworm image
# defaults it to "local" -- no automatic toolchain download -- so the same
# install fails outright here with "requires go >= 1.26 (running go 1.24.x;
# GOTOOLCHAIN=local)" even with the version pinned. Reproduced on a real
# Northflank build of this exact Dockerfile. Setting GOTOOLCHAIN=auto
# restores the GitHub-Actions-equivalent behavior: go transparently
# downloads and uses go1.26.x for this one install step, same as ci.yml's
# job already does for trivy.
FROM golang:1.24-bookworm AS engines
ENV GOTOOLCHAIN=auto

# osv-scanner, nuclei, naabu: all Apache-2.0/MIT, official `go install` path
# per each project's own README.
RUN apt-get update && apt-get install -y --no-install-recommends libpcap-dev \
    && rm -rf /var/lib/apt/lists/*
RUN go install github.com/google/osv-scanner/cmd/osv-scanner@v1.9.2 \
    && go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@v3.11.1 \
    && go install github.com/projectdiscovery/naabu/v2/cmd/naabu@v2.6.1

# Trivy's go.mod requires the jsonv2 stdlib experiment; see
# aquasecurity/trivy's own install docs for the current recommended method.
RUN GOEXPERIMENT=jsonv2 go install github.com/aquasecurity/trivy/cmd/trivy@v0.74.0

# Verify all four binaries actually landed in GOBIN before the final stage's
# COPY --from tries to read them. A real Northflank build of this Dockerfile
# hit "COPY --from=engines ... /root/go/bin/trivy: not found" with the
# preceding install steps all reporting success (DONE, no error) -- this ls
# check proved the real cause: the official golang Docker images set
# GOPATH=/go (not the Go-default $HOME/go=/root/go), so `go install` was
# writing every binary to /go/bin the whole time and /root/go/bin never
# existed at all. Fixed by pointing both this check and the COPY below at
# /go/bin instead.
RUN ls -la /go/bin/osv-scanner /go/bin/nuclei /go/bin/naabu /go/bin/trivy

FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
# --ignore-installed: bookworm-slim ships a system PyJWT via apt/dist-packages
# that pip can't cleanly uninstall -- same issue documented in the root
# Dockerfile for the quantum subprocess's pip install.
RUN pip3 install --break-system-packages --ignore-installed --no-cache-dir semgrep

COPY --from=engines /go/bin/osv-scanner /go/bin/nuclei /go/bin/naabu /go/bin/trivy /usr/local/bin/

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src/ src/

RUN chown -R node:node /app
USER node

ENV NODE_ENV=production
CMD ["node", "src/worker.js"]
