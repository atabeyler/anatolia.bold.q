# BCI worker image: runs src/worker.js (the scan/data plane) separately from
# the API image (Dockerfile, the control plane) -- spec section 6 requires
# these isolated so a compromised/crashed worker is never a compromise of
# BCI Core. Installs the M5 engine adapters' binaries using each project's
# own documented method.
#
# NOTE: this Dockerfile was written and reviewed but its build could not be
# verified end-to-end in the sandbox this was developed in -- that sandbox's
# network policy blocks the GitHub API calls a couple of these install steps
# make (`nuclei -update-templates` hit the same block; ordinary `go install`
# and `pip install` worked fine). Build and smoke-test this image before
# relying on it.
FROM golang:1.24-bookworm AS engines

# osv-scanner, nuclei, naabu: all Apache-2.0/MIT, official `go install` path
# per each project's own README.
RUN apt-get update && apt-get install -y --no-install-recommends libpcap-dev \
    && rm -rf /var/lib/apt/lists/*
RUN go install github.com/google/osv-scanner/cmd/osv-scanner@latest \
    && go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest \
    && go install github.com/projectdiscovery/naabu/v2/cmd/naabu@latest

# Trivy's go.mod currently requires the jsonv2 stdlib experiment; see
# aquasecurity/trivy's own install docs for the current recommended method.
RUN GOEXPERIMENT=jsonv2 go install github.com/aquasecurity/trivy/cmd/trivy@latest

FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
# --ignore-installed: bookworm-slim ships a system PyJWT via apt/dist-packages
# that pip can't cleanly uninstall -- same issue documented in the root
# Dockerfile for the quantum subprocess's pip install.
RUN pip3 install --break-system-packages --ignore-installed --no-cache-dir semgrep

COPY --from=engines /root/go/bin/osv-scanner /root/go/bin/nuclei /root/go/bin/naabu /root/go/bin/trivy /usr/local/bin/

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src/ src/

RUN chown -R node:node /app
USER node

ENV NODE_ENV=production
CMD ["node", "src/worker.js"]
