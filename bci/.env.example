# BCI API — environment variables
# Copy to .env for local development. Never commit real .env files.

# Server
NODE_ENV=development
PORT=8081

# Postgres — BCI owns a dedicated database/schema, never shares ANATOLIA-Q's.
BCI_DATABASE_URL=postgres://bci:bci@localhost:5432/bci
BCI_DATABASE_CA_CERT=

# Auth — BCI has its own JWT secret and its own users; it never trusts or
# reuses ANATOLIA-Q's JWT_SECRET or auth_users table.
BCI_JWT_SECRET=
BCI_JWT_TTL_SECONDS=14400

# First-boot bootstrap: creates one organization and one system_admin user
# if (and only if) no organization exists yet. Leave unset after first boot;
# has no effect once an organization exists.
BCI_BOOTSTRAP_ORG_NAME=
BCI_BOOTSTRAP_ADMIN_EMAIL=
BCI_BOOTSTRAP_ADMIN_PASSWORD=

# CORS — comma-separated allowlist of origins permitted to call the BCI API
# directly (e.g. the future standalone BCI UI). The ANATOLIA-Q server calls
# BCI server-to-server and is not subject to this browser CORS check.
BCI_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info

# Gateway integration (M14) -- lets a trusted external system (ANATOLIA-Q)
# mint a BCI session for one of its own authenticated users. Must be set to
# the SAME value as ANATOLIA-Q's own BCI_GATEWAY_SECRET, and must NEVER be
# the same value as BCI_JWT_SECRET above. Unset means every gateway session
# request is rejected (fail closed), not silently accepted.
BCI_GATEWAY_SECRET=
BCI_GATEWAY_ORG_SLUG=anatolia-q
BCI_GATEWAY_SESSION_TTL_SECONDS=900

# AI Decision Support (M13) -- AI_DISABLED is the safe default; BCI's own
# security analysis never depends on this being configured.
BCI_AI_MODE=AI_DISABLED
BCI_ANTHROPIC_API_KEY=

# Engine adapters (M5) -- override only if a binary isn't on PATH under its
# default name. An engine whose binary can't be found reports OFFLINE via
# healthCheck() rather than crashing anything that calls it.
BCI_TRIVY_BIN=trivy
BCI_OSV_SCANNER_BIN=osv-scanner
BCI_SEMGREP_BIN=semgrep
BCI_NUCLEI_BIN=nuclei
BCI_NAABU_BIN=naabu
